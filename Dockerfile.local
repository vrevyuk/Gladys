# Dockerfile.local — build Gladys (front + server) from a local checkout into a
# single all-in-one image, without the multi-arch / qemu machinery of docker/Dockerfile.
#
# Build:  docker build -f Dockerfile.local -t gladys-local .
# Run:    docker run --rm --network host gladys-local          # host net: mDNS/discovery works
#     or  docker run --rm -p 1443:80 gladys-local              # bridged: UI on http://localhost:1443
#
# The server serves the built frontend itself (SERVE_FRONT), so this is one container.

# STEP 1 — Build the frontend (preact) → front/build
FROM node:22-slim AS front
WORKDIR /src/front
COPY front/package*.json ./
RUN npm ci
COPY front ./
# Frontend imports shared constants from ../server (services/*/constants,
# utils/*, config/icons.json). Provide it as a sibling so webpack resolves them.
COPY server /src/server
RUN npm run build

# STEP 2 — Runtime image: server + built front
FROM node:22-slim

# Runtime system dependencies (mirrors docker/Dockerfile)
RUN apt-get update && apt-get install -y --no-install-recommends \
        tzdata \
        nmap \
        ffmpeg \
        sqlite3 \
        openssl \
        gzip \
        udev \
        bluez \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/server

# The server reads the repo-root package.json for its version
# (lib/system/system.init.js → path.join(__dirname, '../../../package.json') = /src/package.json).
COPY package.json /src/package.json

# Copy the server source first, then install production deps. npm ci wipes
# node_modules before installing, and .dockerignore excludes host node_modules,
# so the image always gets a clean production install.
COPY server ./
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        python3-pip \
        git \
        libffi-dev \
    && npm ci --unsafe-perm --production \
    && npm cache clean --force \
    && apt-get purge -y --auto-remove build-essential python3 python3-pip git libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Built frontend → served by the server from server/static (STATIC_FOLDER = server/../static)
COPY --from=front /src/front/build ./static

ENV NODE_ENV=production
ENV SERVER_PORT=80

EXPOSE 80

CMD ["node", "index.js"]
